    {
      "cell_type": "code",
      "source": [
        "def lengthOfLongestSubstring(s):\n",
        "  max_len = 0\n",
        "  longest = \"\"\n",
        "  # Helper function to find the longest substring with unique (non-repeating) characters\n",
        "  for i in range(len(s)):\n",
        "    for j in range(i, len(s)):\n",
        "      sub = s[i:j+1]\n",
        "      # If the number of unique elements (set) equals the length of the substring, it has no duplicates\n",
        "      if len(set(sub)) == len(sub) and len(sub) > max_len:\n",
        "        longest = sub\n",
        "        max_len = len(longest)\n",
        "  return longest\n",
        "\n",
        "# Test the function with a sample string\n",
        "lengthOfLongestSubstring(\"abcabcbb\")"
      ],
