    {
      "cell_type": "code",
      "source": [
        "s = \"abccccbd\"\n",
        "longest = \"\"\n",
        "# Find the longest palindromic substring by checking every possible substring\n",
        "for i in range(len(s)):\n",
        "  for j in range(i, len(s)):\n",
        "    sub = s[i:j+1]\n",
        "    # Check if the substring is equal to its reverse and is longer than the current longest\n",
        "    if sub == sub[::-1] and len(sub) > len(longest):\n",
        "      longest = sub\n",
        "print(longest)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "8c9x-8k6Y9eC",
        "outputId": "45d5d6f1-42bc-4b1f-85f4-8f6f0cc382ab"
      },
      "execution_count": 10,
